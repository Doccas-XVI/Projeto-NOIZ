# Servidor
PORT=3333
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Banco de dados (Neon PostgreSQL em produção, local em dev)
DATABASE_URL="postgresql://user:password@localhost:5432/noiz?schema=public"

# JWT
JWT_ACCESS_SECRET=troque_esta_chave_de_acesso
JWT_REFRESH_SECRET=troque_esta_chave_de_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Supabase (Storage para áudios e imagens)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
SUPABASE_BUCKET_TRACKS=tracks
SUPABASE_BUCKET_IMAGES=images

# E-mail (recuperação de senha) — provedor a definir (ex: Resend, SendGrid)
EMAIL_FROM=noreply@noiz.app
EMAIL_API_KEY=
