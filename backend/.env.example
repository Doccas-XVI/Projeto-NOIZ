# ===== Servidor =====
PORT=3333
NODE_ENV=development
# URL do frontend (CORS libera só esta origem e ela é usada no link do e-mail de reset)
CLIENT_URL=http://localhost:5173

# ===== Banco (PostgreSQL) =====
# Dev local (docker compose up postgres):  postgresql://noiz:noiz@localhost:5432/noiz?schema=public
# Neon (produção): cole a connection string do painel (precisa terminar com ?sslmode=require)
DATABASE_URL="postgresql://noiz:noiz@localhost:5432/noiz?schema=public"

# ===== JWT =====
# Gere valores aleatórios longos:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque_esta_chave_de_acesso_com_um_valor_longo
JWT_REFRESH_SECRET=troque_esta_chave_de_refresh_com_um_valor_longo
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Supabase Storage (OPCIONAL em dev) =====
# Sem isto a API sobe normalmente; só os uploads respondem "armazenamento não configurado".
# Os buckets abaixo são criados automaticamente (públicos) na primeira inicialização.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_TRACKS=tracks
SUPABASE_BUCKET_IMAGES=images

# ===== E-mail de recuperação de senha (OPCIONAL em dev) =====
# Sem EMAIL_API_KEY o link de reset é impresso no terminal do backend.
EMAIL_FROM="NOIZ <onboarding@resend.dev>"
EMAIL_API_KEY=
