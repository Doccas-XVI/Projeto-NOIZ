# Usado SÓ pelo docker-compose (raiz do projeto). Tudo aqui é opcional em desenvolvimento.
# Copie para `.env` para ativar uploads (Supabase) e e-mail de recuperação de senha.

JWT_ACCESS_SECRET=troque_este_segredo_de_acesso_em_dev
JWT_REFRESH_SECRET=troque_este_segredo_de_refresh_em_dev

# Supabase Storage (uploads de música e capas) — https://supabase.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (e-mail de "esqueci a senha") — https://resend.com. Sem chave, o link vai pro log do backend.
EMAIL_API_KEY=
EMAIL_FROM=NOIZ <onboarding@resend.dev>
